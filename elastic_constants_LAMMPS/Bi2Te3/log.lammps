variable C3pos equal -0.000239646409788872
variable C4pos equal ${d4}
variable C4pos equal 0.000113761382524239
variable C5pos equal ${d5}
variable C5pos equal 38.6745208686348
variable C6pos equal ${d6}
variable C6pos equal -20.0889302689326

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(0.00013066828011834+${C1pos})
variable C15 equal 0.5*(0.00013066828011834+-0.000120270605090798)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(7.76286748966257e-05+${C2pos})
variable C25 equal 0.5*(7.76286748966257e-05+-6.74309253330228e-05)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(0.000260933325520978+${C3pos})
variable C35 equal 0.5*(0.000260933325520978+-0.000239646409788872)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(-0.000121554257999478+${C4pos})
