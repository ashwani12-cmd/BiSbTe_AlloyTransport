variable C5pos equal ${d5}
variable C5pos equal -1251.25483327691
variable C6pos equal ${d6}
variable C6pos equal -373.936579941301

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(${C1neg}+${C1pos})
variable C13 equal 0.5*(644343.40615734+${C1pos})
variable C13 equal 0.5*(644343.40615734+-644316.99714653)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(${C2neg}+${C2pos})
variable C23 equal 0.5*(644354.3336298+${C2pos})
variable C23 equal 0.5*(644354.3336298+-644327.14946363)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(${C3neg}+${C3pos})
variable C33 equal 0.5*(1574837.57670226+${C3pos})
variable C33 equal 0.5*(1574837.57670226+-1574795.53343189)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C43 equal 0.5*(${C4neg}+${C4pos})
