variable pyz1 equal -1.51564853431948

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 644344.28427572
variable C2neg equal ${d2}
variable C2neg equal 644408.58343464
variable C3neg equal ${d3}
variable C3neg equal 1574831.08222
