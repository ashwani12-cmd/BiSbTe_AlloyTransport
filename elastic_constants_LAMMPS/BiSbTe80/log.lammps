variable pxy1 equal -2.54858937539094
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 3.45215813301568
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -1.62973587839466

# Compute elastic constant from pressure tensor

variable C1pos equal ${d1}
variable C1pos equal -644316.99714653
variable C2pos equal ${d2}
variable C2pos equal -644327.14946363
variable C3pos equal ${d3}
variable C3pos equal -1574795.53343189
