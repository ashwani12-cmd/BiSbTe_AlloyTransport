# Obtain new stress tensor

variable tmp equal pxx
variable pxx1 equal ${tmp}
variable pxx1 equal -13025.3780725711
variable tmp equal pyy
variable pyy1 equal ${tmp}
variable pyy1 equal -13052.5973557628
variable tmp equal pzz
variable pzz1 equal ${tmp}
variable pzz1 equal -3702.25017571071
variable tmp equal pxy
variable pxy1 equal ${tmp}
variable pxy1 equal -2.54743210143481
variable tmp equal pxz
variable pxz1 equal ${tmp}
variable pxz1 equal 3.45006970047795
variable tmp equal pyz
variable pyz1 equal ${tmp}
variable pyz1 equal -1.73430443955606

# Compute elastic constant from pressure tensor

variable C1neg equal ${d1}
variable C1neg equal 644397.55125299
variable C2neg equal ${d2}
variable C2neg equal 644354.8215744
variable C3neg equal ${d3}
variable C3neg equal 1574830.69198238
variable C4neg equal ${d4}
variable C4neg equal -565.152245741025
variable C5neg equal ${d5}
variable C5neg equal 1251.04599002314
variable C6neg equal ${d6}
variable C6neg equal 374.052307336914

# Reset box and simulation parameters

clear
box tilt large
read_restart restart.equil
Reading restart file ...
  restart file = 24 Mar 2022, LAMMPS = 24 Mar 2022
  restoring atom style atomic from restart
  triclinic box = (0.042726577 0.037058295 0.15121177) to (8.7370624 7.5664617 30.091642) with tilt (-4.3471038 0 0)
