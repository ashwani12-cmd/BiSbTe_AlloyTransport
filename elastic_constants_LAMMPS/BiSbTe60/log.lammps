  triclinic box = (0.043426319 0.037493048 0.14944729) to (8.7363627 7.566027 30.093407) with tilt (-4.3465942 0 0)

# Relax atoms positions

minimize ${etol} ${ftol} ${maxiter} ${maxeval}
minimize 0 ${ftol} ${maxiter} ${maxeval}
minimize 0 1e-18 ${maxiter} ${maxeval}
minimize 0 1e-18 100 ${maxeval}
minimize 0 1e-18 100 1000
