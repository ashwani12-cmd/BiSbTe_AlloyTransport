variable C4pos equal -513.11788913435
variable C5pos equal ${d5}
variable C5pos equal -2801.07318795385
variable C6pos equal ${d6}
variable C6pos equal 3040.66124688533

# Combine positive and negative

variable C1${dir} equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(${C1neg}+${C1pos})
variable C15 equal 0.5*(306842.125468137+${C1pos})
variable C15 equal 0.5*(306842.125468137+-306841.20740286)
variable C2${dir} equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(${C2neg}+${C2pos})
variable C25 equal 0.5*(307870.799056532+${C2pos})
variable C25 equal 0.5*(307870.799056532+-307870.656364844)
variable C3${dir} equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(${C3neg}+${C3pos})
variable C35 equal 0.5*(825041.416584278+${C3pos})
variable C35 equal 0.5*(825041.416584278+-825040.588002518)
variable C4${dir} equal 0.5*(${C4neg}+${C4pos})
variable C45 equal 0.5*(${C4neg}+${C4pos})
